<?xml version="1.0" encoding="utf-8"?><LinearLayout
xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="#071D16">

<!-- DD KITCHEN BRAND HEADER -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="16dp"
    android:paddingBottom="14dp"
    android:background="@drawable/header_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="DD"
            android:textColor="#071D16"
            android:textSize="23sp"
            android:textStyle="bold"
            android:fontFamily="serif"
            android:background="@drawable/logo_circle"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DD KITCHEN"
                android:textColor="@color/gold"
                android:textSize="25sp"
                android:textStyle="bold"
                android:fontFamily="serif"
                android:letterSpacing="0.04"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOOD FOOD. GREAT MOMENTS."
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"/>

        </LinearLayout>

        <FrameLayout
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/icon_circle">

            <TextView
                android:id="@+id/ic_notification"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🔔"
                android:textSize="20sp"
                android:contentDescription="Notifications"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/notification_badge"
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/badge_red"
                android:visibility="gone"/>

        </FrameLayout>

        <FrameLayout
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:background="@drawable/icon_circle">

            <TextView
                android:id="@+id/ic_cart_header"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="🛒"
                android:textSize="20sp"
                android:contentDescription="Shopping cart"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/cart_badge"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="top|end"
                android:gravity="center"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/badge_red"
                android:visibility="gone"/>

        </FrameLayout>

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="13dp"
        android:text="Your cravings, our passion."
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:fontFamily="serif"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Freshly prepared meals, made to delight."
        android:textColor="#D9E9E1"
        android:textSize="12sp"/>

</LinearLayout>

<View
    android:layout_width="match_parent"
    android:layout_height="3dp"
    android:background="@color/gold"/>

<!-- HERO FOOD BANNER -->
<FrameLayout
    android:layout_width="match_parent"
    android:layout_height="190dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/images8"
        android:scaleType="centerCrop"
        android:contentDescription="Featured meal"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/hero_overlay"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="bottom"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="15dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MADE WITH LOVE"
            android:textColor="@color/gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.18"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Taste The Difference"
            android:textColor="#FFFFFF"
            android:textSize="29sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Delicious meals. Memorable moments."
            android:textColor="#FFFFFF"
            android:textSize="12sp"/>

        <TextView
            android:id="@+id/btn_order_now"
            android:layout_width="145dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="EXPLORE MENU  →"
            android:textColor="#071D16"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/order_button"/>

    </LinearLayout>

</FrameLayout>

<!-- FOOD CATEGORIES -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="7dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="WHAT ARE YOU CRAVING?"
        android:textColor="#123C2B"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.06"/>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="85dp"
        android:scrollbars="none"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <LinearLayout
                android:layout_width="91dp"
                android:layout_height="78dp"
                android:layout_marginEnd="9dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/category_card">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="46dp"
                    android:src="@drawable/images"
                    android:scaleType="centerCrop"
                    android:contentDescription="African food"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="African"
                    android:textColor="#123C2B"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="91dp"
                android:layout_height="78dp"
                android:layout_marginEnd="9dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/category_card">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="46dp"
                    android:src="@drawable/images234"
                    android:scaleType="centerCrop"
                    android:contentDescription="Continental food"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Continental"
                    android:textColor="#123C2B"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="91dp"
                android:layout_height="78dp"
                android:layout_marginEnd="9dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/category_card">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="46dp"
                    android:src="@drawable/images10"
                    android:scaleType="centerCrop"
                    android:contentDescription="Snacks"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Snacks"
                    android:textColor="#123C2B"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="91dp"
                android:layout_height="78dp"
                android:layout_marginEnd="9dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/category_card">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="46dp"
                    android:src="@drawable/images11"
                    android:scaleType="centerCrop"
                    android:contentDescription="Soups and stews"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Soups"
                    android:textColor="#123C2B"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="91dp"
                android:layout_height="78dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/category_card">

                <ImageView
                    android:layout_width="55dp"
                    android:layout_height="46dp"
                    android:src="@drawable/images15"
                    android:scaleType="centerCrop"
                    android:contentDescription="Rice dishes"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Rice Dishes"
                    android:textColor="#123C2B"
                    android:textSize="11sp"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>

<!-- FEATURED DISHES HEADING -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="15dp"
    android:background="#071D16">

    <View
        android:layout_width="5dp"
        android:layout_height="29dp"
        android:background="@drawable/gold_pill"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Customer Favourites"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold"
            android:fontFamily="serif"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Goodness in every bite"
            android:textColor="#C6D8CE"
            android:textSize="10sp"/>

    </LinearLayout>

    <TextView
        android:id="@+id/btn_view_all"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:gravity="center"
        android:paddingStart="8dp"
        android:paddingEnd="2dp"
        android:text="View All  ›"
        android:textColor="@color/gold"
        android:textSize="12sp"
        android:textStyle="bold"
        android:clickable="true"
        android:focusable="true"/>

</LinearLayout>

<!-- FOOD LIST -->
<androidx.recyclerview.widget.RecyclerView
    android:id="@+id/dishes_recycler"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="5dp"
    android:paddingBottom="8dp"
    android:clipToPadding="false"
    android:background="#071D16"/>

<!-- BOTTOM NAVIGATION -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="65dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="#FFFFFF"
    android:elevation="8dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/ic_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_home"
            android:tint="#087653"
            android:contentDescription="Home"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="#087653"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_search"
            android:tint="#087653"
            android:contentDescription="Menu"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textColor="#087653"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_cart_nav"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:src="@drawable/ic_cart"
            android:tint="#087653"
            android:contentDescription="Cart"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cart"
            android:textColor="#087653"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_orders"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_orders"
            android:tint="#087653"
            android:contentDescription="Music"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Music"
            android:textColor="#087653"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_person"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person"
            android:tint="#087653"
            android:contentDescription="Profile"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#087653"
            android:textSize="10sp"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>

<!-- DD KITCHEN FOOTER -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="29dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:background="#071D16">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DD KITCHEN"
        android:textColor="@color/gold"
        android:textSize="10sp"
        android:textStyle="bold"
        android:letterSpacing="0.12"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="•  Made for food lovers"
        android:textColor="#D8E7DF"
        android:textSize="9sp"/>

</LinearLayout>

</LinearLayout>
