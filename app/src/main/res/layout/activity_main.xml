<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:background="#111111">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="14dp">

        <!-- Brand header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="82dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:background="#1C1A16">

            <TextView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="🍗"
                android:textSize="30sp"
                android:background="#302719"
                android:contentDescription="Chicken and Co. logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chicken and Co."
                    android:textColor="#F4B942"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Delicious meals. Great moments."
                    android:textColor="#E0D8C8"
                    android:textSize="10sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/ic_cart_header"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:gravity="center"
                android:text="🛒"
                android:textSize="23sp"
                android:background="#302719"
                android:contentDescription="Shopping cart"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Welcome section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="27dp"
            android:paddingBottom="23dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome to Chicken and Co."
                android:textColor="#F4B942"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Good food, made&#10;to bring people together."
                android:textColor="#FFFFFF"
                android:textSize="29sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif"
                android:lineSpacingMultiplier="1.05" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Enjoy freshly prepared meals, rich flavours and the comfort of a great meal."
                android:textColor="#D0CCC3"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="7dp"
                android:paddingBottom="7dp"
                android:text="Made with love, served with care."
                android:textColor="#F4B942"
                android:textSize="12sp"
                android:background="#302719" />

        </LinearLayout>

        <!-- Featured meal -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="265dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/images8"
                android:scaleType="centerCrop"
                android:contentDescription="Featured meal from Chicken and Co." />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#66000000" />

            <View
                android:layout_width="5dp"
                android:layout_height="match_parent"
                android:background="#F4B942"
                android:layout_gravity="start" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="vertical"
                android:padding="17dp"
                android:background="#D9000000">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Something delicious awaits"
                    android:textColor="#F4B942"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Your next favourite meal is here."
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Freshly prepared. Full of flavour."
                    android:textColor="#E0D8C8"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/btn_order_now"
                    android:layout_width="170dp"
                    android:layout_height="46dp"
                    android:layout_marginTop="13dp"
                    android:gravity="center"
                    android:text="Explore our menu  →"
                    android:textColor="#17130C"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="#F4B942"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

        </FrameLayout>

        <!-- Food categories -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="25dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="What are you craving?"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="5dp"
                android:paddingBottom="14dp"
                android:text="Find a meal to make your day."
                android:textColor="#C9C2B5"
                android:textSize="13sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp">

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="116dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#25211A">

                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="74dp"
                            android:src="@drawable/images"
                            android:scaleType="centerCrop"
                            android:contentDescription="African dishes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="African dishes"
                            android:textColor="#F4B942"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="116dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#25211A">

                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="74dp"
                            android:src="@drawable/images234"
                            android:scaleType="centerCrop"
                            android:contentDescription="Continental dishes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Continental"
                            android:textColor="#F4B942"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="116dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#25211A">

                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="74dp"
                            android:src="@drawable/images10"
                            android:scaleType="centerCrop"
                            android:contentDescription="Small chops" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Small chops"
                            android:textColor="#F4B942"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="116dp"
                        android:layout_marginEnd="10dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#25211A">

                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="74dp"
                            android:src="@drawable/images11"
                            android:scaleType="centerCrop"
                            android:contentDescription="Soups and pepper soup" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Soups"
                            android:textColor="#F4B942"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="100dp"
                        android:layout_height="116dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="#25211A">

                        <ImageView
                            android:layout_width="78dp"
                            android:layout_height="74dp"
                            android:src="@drawable/images15"
                            android:scaleType="centerCrop"
                            android:contentDescription="Rice dishes" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:text="Rice meals"
                            android:textColor="#F4B942"
                            android:textSize="10sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </HorizontalScrollView>

        </LinearLayout>

        <!-- Promotional panel -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="17dp"
            android:background="#302719">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good food brings us together."
                    android:textColor="#F4B942"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Make every meal a great moment."
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="✦"
                android:textColor="#F4B942"
                android:textSize="36sp" />

        </LinearLayout>

        <!-- Customer favourites -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="17dp"
            android:paddingEnd="17dp"
            android:paddingTop="26dp"
            android:paddingBottom="12dp">

            <View
                android:layout_width="4dp"
                android:layout_height="43dp"
                android:background="#F4B942" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="11dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Customer favourites"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Meals worth coming back for."
                    android:textColor="#C9C2B5"
                    android:textSize="11sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_view_all"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="View all  →"
                android:textColor="#F4B942"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

        <!-- Existing dish list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/dishes_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingBottom="12dp"
            android:clipToPadding="false" />

        <!-- Footer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingTop="22dp"
            android:paddingBottom="22dp"
            android:background="#1C1A16">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chicken and Co."
                android:textColor="#F4B942"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Delicious meals. Great moments. Made with love."
                android:textColor="#E0D8C8"
                android:textSize="11sp"
                android:gravity="center" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Ibadan Road, Ijebu Ode, Ogun State"
                android:textColor="#B8A783"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

<!-- Fixed bottom navigation -->
<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingTop="5dp"
    android:paddingBottom="4dp"
    android:background="#1C1A16"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/ic_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌂"
            android:textColor="#F4B942"
            android:textSize="25sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Home"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_search"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☷"
            android:textColor="#FFFFFF"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menu"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_cart_nav"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛒"
            android:textSize="21sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cart"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_orders"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="♫"
            android:textColor="#FFFFFF"
            android:textSize="23sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Music"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ic_person"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="●"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profile"
            android:textColor="#FFFFFF"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>

</LinearLayout>
