<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#063B2B">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Official logo and brand header -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="235dp"
                android:background="#063B2B">

                <ImageView
                    android:id="@+id/home_brand_logo"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/hp"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:padding="8dp"
                    android:contentDescription="Official Chicken and Co. logo" />

                <TextView
                    android:id="@+id/ic_cart_header"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="23sp"
                    android:background="#F4B942"
                    android:contentDescription="Shopping cart"
                    android:clickable="true"
                    android:focusable="true"
                    android:elevation="8dp" />

            </FrameLayout>

            <!-- Welcome section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="24dp"
                android:background="#063B2B">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Welcome to Chicken and Co."
                    android:textColor="#F4B942"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:text="Good food, made&#10;to bring people together."
                    android:textColor="#FFFFFF"
                    android:textSize="29sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif"
                    android:lineSpacingMultiplier="1.05" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Enjoy freshly prepared meals, rich flavours and the comfort of a great meal."
                    android:textColor="#E0EEE7"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:paddingTop="9dp"
                    android:paddingBottom="9dp"
                    android:text="✦  Made with love, served with care"
                    android:textColor="#F4B942"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#104C39" />

            </LinearLayout>

            <!-- Featured meal -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:background="#104C39"
                android:elevation="5dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/images8"
                    android:scaleType="centerCrop"
                    android:contentDescription="Featured Chicken and Co. Ijebu Ode" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#80000000" />

                <View
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:background="#F4B942"
                    android:layout_gravity="start" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:orientation="vertical"
                    android:padding="17dp"
                    android:background="#E6062D22">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Something delicious awaits"
                        android:textColor="#F4B942"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Your next favourite meal is here."
                        android:textColor="#FFFFFF"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Freshly prepared. Full of flavour."
                        android:textColor="#E0EEE7"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/btn_order_now"
                        android:layout_width="190dp"
                        android:layout_height="48dp"
                        android:layout_marginTop="13dp"
                        android:gravity="center"
                        android:text="Explore our menu  →"
                        android:textColor="#063B2B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="#F4B942"
                        android:clickable="true"
                        android:focusable="true" />

                </LinearLayout>

            </FrameLayout>

            <!-- Food categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="27dp"
                android:paddingBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="What are you craving?"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="14dp"
                    android:text="Find a meal to make your day."
                    android:textColor="#D4E7DD"
                    android:textSize="13sp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:paddingStart="15dp"
                        android:paddingEnd="15dp">

                        <!-- African dishes -->
                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="122dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="5dp"
                            android:background="#104C39"
                            android:elevation="3dp">

                            <ImageView
                                android:layout_width="88dp"
                                android:layout_height="82dp"
                                android:src="@drawable/images"
                                android:scaleType="centerCrop"
                                android:contentDescription="African dishes" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="African dishes"
                                android:textColor="#F4B942"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Continental -->
                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="122dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="5dp"
                            android:background="#104C39"
                            android:elevation="3dp">

                            <ImageView
                                android:layout_width="88dp"
                                android:layout_height="82dp"
                                android:src="@drawable/images234"
                                android:scaleType="centerCrop"
                                android:contentDescription="Continental dishes" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Continental"
                                android:textColor="#F4B942"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Small chops -->
                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="122dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="5dp"
                            android:background="#104C39"
                            android:elevation="3dp">

                            <ImageView
                                android:layout_width="88dp"
                                android:layout_height="82dp"
                                android:src="@drawable/images10"
                                android:scaleType="centerCrop"
                                android:contentDescription="Small chops" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Small chops"
                                android:textColor="#F4B942"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Soups -->
                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="122dp"
                            android:layout_marginEnd="10dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="5dp"
                            android:background="#104C39"
                            android:elevation="3dp">

                            <ImageView
                                android:layout_width="88dp"
                                android:layout_height="82dp"
                                android:src="@drawable/images11"
                                android:scaleType="centerCrop"
                                android:contentDescription="Soups and pepper soup" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Soups"
                                android:textColor="#F4B942"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <!-- Rice meals -->
                        <LinearLayout
                            android:layout_width="108dp"
                            android:layout_height="122dp"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="5dp"
                            android:background="#104C39"
                            android:elevation="3dp">

                            <ImageView
                                android:layout_width="88dp"
                                android:layout_height="82dp"
                                android:src="@drawable/images15"
                                android:scaleType="centerCrop"
                                android:contentDescription="Rice meals" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="Rice meals"
                                android:textColor="#F4B942"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                    </LinearLayout>

                </HorizontalScrollView>

            </LinearLayout>

            <!-- Promotional panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="17dp"
                android:background="#104C39"
                android:elevation="3dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Good food brings us together."
                        android:textColor="#F4B942"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Make every meal a great moment."
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:gravity="center"
                    android:text="✦"
                    android:textColor="#F4B942"
                    android:textSize="36sp" />

            </LinearLayout>

            <!-- Customer favourites heading -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="17dp"
                android:paddingEnd="17dp"
                android:paddingTop="27dp"
                android:paddingBottom="12dp">

                <View
                    android:layout_width="4dp"
                    android:layout_height="43dp"
                    android:background="#F4B942" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="11dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Customer favourites"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Meals worth coming back for."
                        android:textColor="#D4E7DD"
                        android:textSize="12sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btn_view_all"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="View all  →"
                    android:textColor="#F4B942"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

            </LinearLayout>

            <!-- Existing dish list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/dishes_recycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:paddingStart="7dp"
                android:paddingEnd="7dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false" />

            <!-- Footer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:paddingTop="24dp"
                android:paddingBottom="24dp"
                android:background="#042D21">

                <ImageView
                    android:layout_width="150dp"
                    android:layout_height="75dp"
                    android:src="@drawable/hp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Chicken and Co. official logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Delicious meals. Great moments. Made with love."
                    android:textColor="#E0EEE7"
                    android:textSize="12sp"
                    android:gravity="center" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:text="Ibadan Road, Ijebu Ode, Ogun State"
                    android:textColor="#F4B942"
                    android:textSize="12sp"
                    android:gravity="center" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Fixed bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="66dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="5dp"
        android:paddingBottom="4dp"
        android:background="#042D21"
        android:elevation="10dp">

        <LinearLayout
            android:id="@+id/ic_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⌂"
                android:textColor="#F4B942"
                android:textSize="25sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ic_search"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="☷"
                android:textColor="#FFFFFF"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Menu"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ic_cart_nav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛒"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cart"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ic_orders"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="♫"
                android:textColor="#FFFFFF"
                android:textSize="23sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Music"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ic_person"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#FFFFFF"
                android:textSize="20sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
