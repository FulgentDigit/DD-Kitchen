<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#002D21"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="68dp"
            android:background="@color/header_green"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/back_btn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                android:background="?android:attr/selectableItemBackgroundBorderless" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍴 DD KITCHEN"
                    android:textColor="#FFFFFF"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SMART RESTAURANT SERVICE"
                    android:textColor="@color/gold"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

            </LinearLayout>

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/alert_red" />

        <!-- RESTAURANT INTRODUCTION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:padding="18dp"
            android:orientation="vertical"
            android:background="#FFFFFF">

            <TextView
                android:id="@+id/restaurant_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DD KITCHEN"
                android:textColor="#002D21"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/restaurant_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="📍 Off Olisa Road, Ijebu Ode, Ogun State, Nigeria"
                android:textColor="#555555"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <TextView
                android:id="@+id/menu_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Freshly prepared. Made with love."
                android:textColor="#006B4F"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Explore our African and Continental dishes. Tap any meal to add it to your cart."
                android:textColor="#555555"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />

        </LinearLayout>

        <!-- CATEGORIES -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/category_all"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:text="ALL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#C62828" />

                <Button
                    android:id="@+id/category_african"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="AFRICAN"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#006B4F" />

                <Button
                    android:id="@+id/category_continental"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="CONTINENTAL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#006B4F" />

                <Button
                    android:id="@+id/category_grills"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="GRILLS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#006B4F" />

                <Button
                    android:id="@+id/category_rice"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="RICE"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#006B4F" />

                <Button
                    android:id="@+id/category_soups"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:text="SOUPS"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#006B4F" />

            </LinearLayout>

        </HorizontalScrollView>

        <!-- MENU TITLE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="OUR MENU"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fresh • Tasty • Local"
                android:textColor="@color/gold"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- MENU LIST -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/menu_recycler"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- CUSTOM ORDER -->
        <LinearLayout
            android:id="@+id/custom_order_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:background="#FFFFFF"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:gravity="center"
                android:text="🎤"
                android:textSize="27sp"
                android:background="#FFF3D6" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Can't find what you want?"
                    android:textColor="#002D21"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Create a custom request by text or voice."
                    android:textColor="#666666"
                    android:textSize="12sp" />

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textColor="#C62828"
                android:textSize="30sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- RESTAURANT INFORMATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#001F17">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DD KITCHEN"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="📍 OUR LOCATION"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Off Olisa Road, Ijebu Ode, Ogun State, Nigeria"
                android:textColor="#CCCCCC"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/whatsapp_btn"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="💬  CHAT WITH US ON WHATSAPP"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#087F4F"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="+234 907 891 7130"
                android:textColor="@color/gold"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center"
                android:text="Experience Smart Restaurant Service in Ijebu Ode"
                android:textColor="#AAAAAA"
                android:textSize="11sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="Developed by Fulgent Digital Clinic"
                android:textColor="#777777"
                android:textSize="10sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
