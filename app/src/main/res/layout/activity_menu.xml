<?xml version="1.0" encoding="utf-8"?><ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#111111"
android:fillViewport="true"
android:clipToPadding="false"
android:scrollbars="none">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <!-- PREMIUM HEADER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:background="#181818">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:padding="10dp"
            android:src="@drawable/ic_back"
            android:contentDescription="Go back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:tint="#F4B942" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CHICKEN &amp; CO."
                android:textColor="#F4B942"
                android:textSize="21sp"
                android:textStyle="bold"
                android:letterSpacing="0.04" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE GOLDEN GRILL EXPERIENCE"
                android:textColor="#D1D1D1"
                android:textSize="9sp"
                android:textStyle="bold"
                android:letterSpacing="0.10"
                android:layout_marginTop="3dp" />

        </LinearLayout>

        <TextView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:gravity="center"
            android:text="🍗"
            android:textSize="25sp"
            android:background="#29251C"
            android:contentDescription="Chicken and Co. logo" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#F4B942" />

    <!-- HERO BANNER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="18dp"
        android:orientation="vertical"
        android:padding="22dp"
        android:background="#25211A"
        android:elevation="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥  MADE FRESH. SERVED HOT."
            android:textColor="#F4B942"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.10" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="CRISPY.\nJUICY.\nIRRESISTIBLE."
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:fontFamily="sans"
            android:textStyle="bold"
            android:lineSpacingMultiplier="0.94" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Your next favourite meal is waiting. Discover great flavour at Chicken and Co."
            android:textColor="#D6D0C4"
            android:textSize="14sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="EXPLORE OUR MENU  →"
            android:textColor="#17130B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="#F4B942" />

        <TextView
            android:id="@+id/restaurant_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Chicken and Co."
            android:textColor="#F4B942"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/restaurant_address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="📍 Ibadan Road, Ijebu Ode, Ogun State, Nigeria"
            android:textColor="#C9C3B7"
            android:textSize="11sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:id="@+id/menu_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Freshly prepared. Made with love."
            android:textColor="#F4B942"
            android:textSize="12sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- SECTION TITLE -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="26dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WHAT ARE YOU CRAVING?"
            android:textColor="#FFFFFF"
            android:textSize="21sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="Choose your flavour. Make it a great meal."
            android:textColor="#B7B7B7"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- CATEGORY FILTERS: EXISTING IDS PRESERVED -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/category_all"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:text="ALL"
                android:textColor="#17130B"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#F4B942"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/category_african"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="AFRICAN"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#303030"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/category_continental"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="CONTINENTAL"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#303030"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/category_grills"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="GRILLS"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#303030"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/category_rice"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="RICE"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#303030"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null" />

            <Button
                android:id="@+id/category_soups"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:text="SOUPS"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:backgroundTint="#303030"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null" />

        </LinearLayout>

    </HorizontalScrollView>

    <!-- MENU LIST HEADING -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="THE MENU"
                android:textColor="#F4B942"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Made for your appetite."
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FRESH • TASTY • LOCAL"
            android:textColor="#BDBDBD"
            android:textSize="9sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- EXISTING MENU RECYCLER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/menu_recycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:overScrollMode="never" />

    <!-- CUSTOM ORDER PANEL -->
    <LinearLayout
        android:id="@+id/custom_order_btn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="18dp"
        android:background="#25211A"
        android:clickable="true"
        android:focusable="true"
        android:elevation="4dp">

        <TextView
            android:layout_width="54dp"
            android:layout_height="54dp"
            android:gravity="center"
            android:text="🎙️"
            android:textSize="28sp"
            android:background="#3A3020" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="YOUR MEAL, YOUR WAY"
                android:textColor="#F4B942"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.07" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Can't find what you want?"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Request a custom meal using text or voice."
                android:textColor="#C7C2B8"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="›"
            android:textColor="#F4B942"
            android:textSize="32sp"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- RESTAURANT FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="26dp"
        android:paddingBottom="24dp"
        android:background="#080808">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CHICKEN &amp; CO."
            android:textColor="#F4B942"
            android:textSize="22sp"
            android:textStyle="bold"
            android:letterSpacing="0.06" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Delicious Meals. Great Moments. Made with Love."
            android:textColor="#D0D0D0"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp" />

        <View
            android:layout_width="54dp"
            android:layout_height="3dp"
            android:layout_marginTop="18dp"
            android:background="#F4B942" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="📍  FIND US"
            android:textColor="#F4B942"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Ibadan Road, Ijebu Ode, Ogun State, Nigeria"
            android:textColor="#D2D2D2"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:id="@+id/whatsapp_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="💬   CHAT WITH US ON WHATSAPP"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.03"
            android:background="#168653"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="07089364492"
            android:textColor="#F4B942"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="A BETTER BITE. A BETTER EXPERIENCE."
            android:textColor="#8D8D8D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Developed by Fulgent Digital Clinic"
            android:textColor="#666666"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>

</ScrollView>
