<?xml version="1.0" encoding="utf-8"?><LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:orientation="vertical"
android:gravity="center"
android:padding="28dp"
android:background="#111111">

<!-- Gold brand accent -->
<View
    android:layout_width="76dp"
    android:layout_height="4dp"
    android:background="#F4B942"
    android:layout_marginBottom="28dp" />

<!-- Restaurant symbol -->
<TextView
    android:layout_width="112dp"
    android:layout_height="112dp"
    android:gravity="center"
    android:text="🍗"
    android:textSize="62sp"
    android:background="#25211A"
    android:elevation="8dp"
    android:contentDescription="Chicken and Co. restaurant logo" />

<!-- Restaurant name -->
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="26dp"
    android:gravity="center"
    android:text="Chicken and Co."
    android:textColor="#F4B942"
    android:textSize="30sp"
    android:textStyle="bold"
    android:fontFamily="sans" />

<!-- Tagline -->
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:gravity="center"
    android:text="Delicious meals. Great moments. Made with love."
    android:textColor="#F5E8C9"
    android:textSize="15sp"
    android:lineSpacingExtra="4dp" />

<!-- Loading indicator -->
<ProgressBar
    android:layout_width="42dp"
    android:layout_height="42dp"
    android:layout_marginTop="42dp"
    android:indeterminate="true"
    android:indeterminateTint="#F4B942" />

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="14dp"
    android:text="Preparing something delicious..."
    android:textColor="#D0CCC3"
    android:textSize="13sp" />

<!-- Location -->
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="42dp"
    android:gravity="center"
    android:text="Ibadan Road, Ijebu Ode, Ogun State"
    android:textColor="#B8A783"
    android:textSize="12sp" />

</LinearLayout>
